# Generated by the toolchain, not by a person. tsconfig.tsbuildinfo is half a
# megabyte of absolute host paths that conflicts on every merge; next-env.d.ts
# is rewritten by `next build`.
#
# NOT ignored, deliberately: backend/src/payload-types.ts (the app imports it,
# so it has to be in the tree) and backend/src/migrations/ (the schema history
# is the record of what production actually ran).
backend/tsconfig.tsbuildinfo
backend/next-env.d.ts
