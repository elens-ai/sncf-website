# Generate a random secret: openssl rand -base64 32. Never commit backend/.env.
PAYLOAD_SECRET=
# Local development requires no external database. Production: postgres://...
DATABASE_URI=file:./cms-dev.db
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_PUBLIC_SITE_URL=http://localhost:3000
CMS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
# Optional location passed to npm run seed -- /path/to/seed.json
CMS_SEED_FILE=seed/site-content.json

# Payment adapter (server only). Use test credentials first; never VITE_ variables.
# Activation also requires donor storage and verified mobile/email sessions.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The serverless CMS (sst.config.ts) sets these itself; they are listed for a
# server of your own. Media on S3, public at CMS_MEDIA_URL; the published
# snapshot copied into the website's bucket; migrations applied, and an empty
# database seeded, as the server starts.
CMS_MEDIA_BUCKET=
CMS_MEDIA_URL=
SITE_SNAPSHOT_BUCKET=
SITE_SNAPSHOT_KEY=api/site-content
SITE_SNAPSHOT_REGION=ap-south-1
CMS_RUN_MIGRATIONS=false
CMS_SEED_ON_INIT=false
