# ─────────────────────────────────────────────────────────────────────────────
# SNCF CMS — backend environment
#
# Copy to backend/.env for local work. NEVER commit a filled-in copy: the
# secret below signs admin sessions, and the database URL is a credential.
# ─────────────────────────────────────────────────────────────────────────────

# Signs JWTs and encrypts stored credentials. Generate a fresh one per
# environment:  openssl rand -base64 32
PAYLOAD_SECRET=change-me-generate-with-openssl-rand-base64-32

# Postgres. The docker-compose service name is `db`; use localhost when
# running the CMS outside Docker against the composed database.
DATABASE_URI=postgres://sncf:sncf@localhost:5433/sncf_cms

# Where the admin UI is reachable. Used for absolute links in emails and for
# the preview URLs the editorial workflow hands out.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# The Vite site this content is published into. Draft-preview links point at
# it, and it is the allowed CORS/CSRF origin for the runtime API.
PAYLOAD_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the frontend sends to view unpublished drafts. Any value, as
# long as both sides agree:  openssl rand -hex 24
PREVIEW_SECRET=change-me-generate-with-openssl-rand-hex-24

# ── Donations (Razorpay) ─────────────────────────────────────────────────────
# The application NEVER sees card details: it creates an order server-side,
# Razorpay's own hosted checkout collects payment, and we verify the signed
# webhook. Only the resulting donation record and 80G receipt data are stored.
# Leave blank to keep the donations module dormant.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
